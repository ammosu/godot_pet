# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg

# export_presets.cfg IS committed — it carries the per-pixel transparency and
# privacy settings the app needs, and Godot keeps signing/notarisation secrets in
# a separate file:
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build / export output
/build/
/export/

# Secrets — API keys must never be committed.
# Runtime config lives in user:// (macOS: ~/Library/Application Support/Godot/app_userdata/Godot Pet/)
*.secret
secrets.cfg
.env

# tools/ carries a Python helper (the qwen3-tts daemon); importing it for a test
# leaves bytecode behind, and the file the app runs is a copy in user:// anyway.
__pycache__/

# The docs' screenshots grow a .import sidecar on every `--headless --import`,
# which is derived and belongs to nobody.
docs/images/*.import

# tools/compositor_bench.py appends its runs here, and they are one machine's
# numbers on one afternoon. What is worth keeping goes in the doc.
compositor-bench.jsonl

# macOS
.DS_Store
