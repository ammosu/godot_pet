# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg

# export_presets.cfg IS committed — it carries the per-pixel transparency and
# privacy settings the app needs, and Godot keeps signing/notarisation secrets in
# a separate file:
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build / export output
/build/
/export/

# Secrets — API keys must never be committed.
# Runtime config lives in user:// (macOS: ~/Library/Application Support/Godot/app_userdata/Godot Pet/)
*.secret
secrets.cfg
.env

# macOS
.DS_Store
