; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Godot Pet"
run/main_scene="res://pet/pet.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
run/max_fps=60

[autoload]

Config="*res://autoload/config.gd"
EventBus="*res://autoload/event_bus.gd"
; After EventBus: it connects to pet_activity_changed on _ready().
FrameBudget="*res://autoload/frame_budget.gd"
CompanionProfile="*res://autoload/companion_profile.gd"
PetState="*res://autoload/pet_state.gd"
MemoryStore="*res://autoload/memory_store.gd"
LLMService="*res://autoload/llm_service.gd"
Nudger="*res://autoload/nudger.gd"
TTSService="*res://autoload/tts_service.gd"
VisionService="*res://autoload/vision_service.gd"
PresenceService="*res://autoload/presence_service.gd"
MonitorService="*res://autoload/monitor_service.gd"
FileDropService="*res://autoload/file_drop_service.gd"
OutboxService="*res://autoload/outbox_service.gd"
CodexCli="*res://autoload/codex_cli.gd"
WorkspaceService="*res://autoload/workspace_service.gd"
WorkService="*res://autoload/work_service.gd"
RecorderService="*res://autoload/recorder_service.gd"
SpeechInputService="*res://autoload/speech_input_service.gd"

[audio]

general/text_to_speech=true
; Permits audio capture at all. The device itself is opened on demand, when an
; AudioStreamMicrophone starts playing — not at startup — so the pet does not sit
; holding the microphone open. See autoload/recorder_service.gd.
driver/enable_input=true

[display]

window/size/viewport_width=320
window/size/viewport_height=320
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true
; Popups must be real OS windows, otherwise they get clipped inside the tiny
; transparent pet window.
window/subwindows/embed_subwindows=false

[gui]

; Bundled fonts have no CJK coverage — fall back to the system's.
theme/custom="res://ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
; Pixel art: never interpolate.
textures/canvas_textures/default_texture_filter=0
; Required to export arm64 / universal macOS builds.
textures/vram_compression/import_etc2_astc=true
