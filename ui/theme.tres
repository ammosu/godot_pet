[gd_resource type="Theme" load_steps=2 format=3]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("PingFang TC", "PingFang SC", "Heiti TC", "Noto Sans CJK TC", "Microsoft JhengHei", "Segoe UI", "Sans-Serif")
subpixel_positioning = 1

[resource]
default_font = SubResource("SystemFont_ui")
default_font_size = 16
